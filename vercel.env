# LinguaFlow: Vercel muhit o'zgaruvchilari (DEMO rejimi)
# Vercel'da: Settings -> Environment Variables -> "Atrof-muhit o'zgaruvchisini qo'shish" -> shu fayl matnini
# birinchi "Key" maydoniga to'liq joylashtiring (paste): Vercel hammasini o'zi ajratadi.
# Joylashtirishdan oldin pastdagi 2 ta joyni TO'LDIRING (BU_YERGA... deb yozilganlar).

# Majburiy: kirish (cookie) imzosi uchun maxfiy kalit. Tayyor, o'zgartirmang. Hech kimga bermang.
SESSION_SECRET=be94c81adceb4bb8d4355d75e6cedeac7c2f51fac9f1ec047deafb58b3d01bb3

# Admin bo'ladigan email(lar). O'zingizning emailingizni yozing (vergul bilan bir nechta).
ADMIN_EMAILS=BU_YERGA_EMAILINGIZNI_YOZING

# Maxfiylik sahifasida ko'rinadigan aloqa emaili
CONTACT_EMAIL=BU_YERGA_EMAILINGIZNI_YOZING

# AI baholash/ustoz uchun (ixtiyoriy). Kalit yo'q bo'lsa, bu 2 qatorni o'chiring: AI'dan boshqa hammasi ishlaydi.
# Yangi kalit: https://aistudio.google.com/apikey  (eskisini ishlatmang)
AI_PROVIDER=gemini
GEMINI_API_KEY=BU_YERGA_YANGI_GEMINI_KALITNI_QOYING
